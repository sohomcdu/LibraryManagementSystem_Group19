@model IEnumerable<LibraryManagementSystem.Models.BorrowRequest>

@*
    A single borrower's full request history, any status
    (BorrowRequestController.ForBorrower). Linked from the Borrower
    Details page so Reception can view everything a specific person has
    ever asked for, not just the shared Pending queue. Still-pending rows
    get the same Approve/Reject actions as the Pending page.
*@

@{
    var isAdmin = User.IsInRole("Admin");
    ViewData["Title"] = "Borrower requests";
}

<h1>Requests from @ViewData["BorrowerName"]</h1>

@if (!Model.Any())
{
    <p class="text-muted">This borrower hasn't made any requests yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Item</th>
                <th>Requested On</th>
                <th>Status</th>
                @if (isAdmin)
                {
                    <th>Decision</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@(r.Item?.Name ?? "N/A")</td>
                    <td>@r.RequestDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        @{
                            var badgeClass = r.Status switch
                            {
                                "Approved" => "bg-success",
                                "Rejected" => "bg-danger",
                                _ => "bg-warning text-dark"
                            };
                        }
                        <span class="badge @badgeClass">@r.Status</span>
                    </td>
                    @if (isAdmin)
                    {
                        <td>
                            @if (r.Status == "Pending")
                            {
                                <form asp-controller="BorrowRequest" asp-action="Approve" asp-route-id="@r.Id" method="post" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                </form>
                                <form asp-controller="BorrowRequest" asp-action="Reject" asp-route-id="@r.Id" method="post" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                </form>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Borrower" asp-action="Index" class="btn btn-secondary">Back to Borrowers</a>
