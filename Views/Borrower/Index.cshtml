@model IEnumerable<LibraryManagementSystem.Models.Borrower>

@*
    Reception's borrower list (BorrowerController.Index). Each row links
    to standard CRUD actions plus a "Requests" shortcut into
    BorrowRequestController.ForBorrower, so Reception can jump straight
    from a borrower's record to everything they've asked to borrow.
*@

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.FullName)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.Phone)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                <a asp-controller="BorrowRequest" asp-action="ForBorrower" asp-route-borrowerId="@item.Id" class="btn btn-sm btn-outline-primary">Requests</a>
            </td>
        </tr>
}
    </tbody>
</table>
