<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    @* This viewport tag is what makes the site responsive on phones,
       satisfying the "search online from their phone" brief requirement
       together with Bootstrap's responsive grid used throughout. *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Library Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body>
    @*
        Shared navigation bar for every page in the site (applied via
        Views/_ViewStart.cshtml). Every menu item is wrapped in a role
        check, so each user only ever sees links to pages they're actually
        allowed to open - this mirrors, rather than replaces, the
        [Authorize(Roles = "...")] checks on the controllers themselves.
    *@
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Library System</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Search" asp-action="Index">Search Catalogue</a></li>

                    @* Admin manages the catalogue items only, not borrower details. *@
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Book" asp-action="Index">Books</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Music" asp-action="Index">Music</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Toy" asp-action="Index">Toys</a></li>
                    }
                    @* Borrower CRUD is Reception-only, per the assignment brief. *@
                    @if (User.IsInRole("Reception"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Borrower" asp-action="Index">Borrowers</a></li>
                    }
                    @* Issuing/returning items is shared between Reception and Admin. *@
                    @if (User.IsInRole("Reception") || User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="BorrowRecord" asp-action="Index">Borrow / Return</a></li>
                    }
                    @if (User.IsInRole("Manager"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Manager" asp-action="Index">Statistics</a></li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item navbar-text me-3 text-light">@User.Identity.Name</li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                            </form>
                        </li>
                        @* Members manage their own borrow requests. *@
                        @if (User.IsInRole("Member"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="BorrowRequest" asp-action="Index">My Requests</a></li>
                        }
                        @* Only Reception approves/rejects requests, matching BorrowRequestController. *@
                        @if (User.IsInRole("Reception"))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="BorrowRequest" asp-action="Pending">Pending Requests</a></li>
                        }
                    }
                    else
                    {
                        @* Signed-out visitors see Log in / Register instead of the account info above. *@
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a></li>
                    }

                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
