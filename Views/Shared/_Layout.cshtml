<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    @*
        This viewport tag makes the site responsive on phones,
        satisfying the "search online from their phone" requirement.
    *@
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Library Management System</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>

<body>

    @*
        Shared navigation bar for every page in the site.

        The menu items are controlled by user roles.
        These role checks control what users see in the navigation,
        while [Authorize(Roles = "...")] on controllers provides
        the actual access control.
    *@

    <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">

        <div class="container">

            <a class="navbar-brand"
               asp-controller="Home"
               asp-action="Index">
                Library System
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navMenu"
                    aria-controls="navMenu"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="navMenu">

                <ul class="navbar-nav me-auto">

                    <!-- Search Catalogue - available to everyone -->
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Search"
                           asp-action="Index">
                            Search Catalogue
                        </a>
                    </li>


                    <!-- ========================= -->
                    <!-- ADMIN NAVIGATION -->
                    <!-- ========================= -->
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Book"
                               asp-action="Index">
                                Books
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Music"
                               asp-action="Index">
                                Music
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Toy"
                               asp-action="Index">
                                Toys
                            </a>
                        </li>

                        <!-- Branch management -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Branch"
                               asp-action="Index">
                                Branches
                            </a>
                        </li>

                        <!-- CSV Data Importer -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Import"
                               asp-action="Index">
                                Data Importer
                            </a>
                        </li>
                    }


                    <!-- ========================= -->
                    <!-- RECEPTION NAVIGATION -->
                    <!-- ========================= -->
                    @if (User.IsInRole("Reception"))
                    {
                        <!-- Borrower management -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Borrower"
                               asp-action="Index">
                                Borrowers
                            </a>
                        </li>
                    }


                    <!-- ========================= -->
                    <!-- RECEPTION + ADMIN -->
                    <!-- ========================= -->
                    @if (User.IsInRole("Reception") || User.IsInRole("Admin"))
                    {
                        <!-- Borrow / Return -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="BorrowRecord"
                               asp-action="Index">
                                Borrow / Return
                            </a>
                        </li>

                        <!-- Item Transfers -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Transfer"
                               asp-action="Index">
                                Transfers
                            </a>
                        </li>

                        <!-- Reservation Holds -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Reservation"
                               asp-action="Holds">
                                Holds
                            </a>
                        </li>

                        <!-- Notifications -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Notification"
                               asp-action="Index">
                                Notifications
                            </a>
                        </li>
                    }


                    <!-- ========================= -->
                    <!-- MANAGER NAVIGATION -->
                    <!-- ========================= -->
                    @if (User.IsInRole("Manager"))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Manager"
                               asp-action="Index">
                                Statistics
                            </a>
                        </li>
                    }

                </ul>


                <!-- ========================= -->
                <!-- RIGHT SIDE ACCOUNT MENU -->
                <!-- ========================= -->

                <ul class="navbar-nav">

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <!-- Logged-in user's name -->
                        <li class="nav-item navbar-text me-3 text-light">
                            @User.Identity.Name
                        </li>

                        <!-- Logout -->
                        <li class="nav-item">

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post">

                                <button type="submit"
                                        class="btn btn-outline-light btn-sm">
                                    Log out
                                </button>

                            </form>

                        </li>


                        <!-- ========================= -->
                        <!-- MEMBER NAVIGATION -->
                        <!-- ========================= -->
                        @if (User.IsInRole("Member"))
                        {
                            <!-- Existing borrow requests -->
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="BorrowRequest"
                                   asp-action="Index">
                                    My Requests
                                </a>
                            </li>

                            <!-- Reservations / Waitlist -->
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Reservation"
                                   asp-action="Index">
                                    My Reservations
                                </a>
                            </li>
                        }


                        <!-- ========================= -->
                        <!-- RECEPTION REQUESTS -->
                        <!-- ========================= -->
                        @if (User.IsInRole("Reception"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="BorrowRequest"
                                   asp-action="Pending">
                                    Pending Requests
                                </a>
                            </li>
                        }

                    }
                    else
                    {
                        <!-- ========================= -->
                        <!-- SIGNED-OUT USERS -->
                        <!-- ========================= -->

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Login">
                                Log in
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Register">
                                Register
                            </a>
                        </li>
                    }

                </ul>

            </div>
        </div>
    </nav>


    <!-- ========================= -->
    <!-- MAIN PAGE CONTENT -->
    <!-- ========================= -->

    <div class="container">

        <main role="main" class="pb-3">
            @RenderBody()
        </main>

    </div>


    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>