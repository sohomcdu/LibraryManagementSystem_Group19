@model LibraryManagementSystem.Models.KioskPageViewModel
@{ ViewData["Title"] = "Self-Service Kiosk"; }
<div class="kiosk-shell">
  <div class="kiosk-top"><div><span class="kiosk-eyebrow">LIBRARY SELF-SERVICE</span><h1>Welcome to the Library</h1><p>Scan your library card or enter your registered email to get started.</p></div><a class="btn btn-outline-light btn-lg" asp-controller="Search" asp-action="Index">Browse catalogue</a></div>
  @if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="alert alert-warning mt-4" role="alert">@Model.Error</div> }
  @if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert alert-success mt-4" role="status">@Model.Message</div> }
  <div class="row g-4 mt-1">
    <div class="col-lg-5"><section class="kiosk-card"><div class="kiosk-step">01 · YOUR ACCOUNT</div><h2>Check your account</h2><form asp-controller="Kiosk" asp-action="Account" method="post"><label class="form-label" for="cardEmail">Library account email</label><input class="form-control form-control-lg" id="cardEmail" name="cardEmail" type="email" value="@Model.CardEmail" required autocomplete="off" /><button class="btn btn-primary btn-lg w-100 mt-3" type="submit">View my account</button></form><p class="small text-secondary mt-3 mb-0">If you need help, please visit the Reception desk.</p></section></div>
    <div class="col-lg-7"><section class="kiosk-card"><div class="kiosk-step">02 · BORROW AN ITEM</div><h2>Scan item code</h2><form asp-controller="Kiosk" asp-action="Checkout" method="post"><label class="form-label" for="checkoutEmail">Registered email</label><input class="form-control form-control-lg mb-3" id="checkoutEmail" name="cardEmail" type="email" value="@Model.CardEmail" required autocomplete="off" /><label class="form-label" for="itemCode">Item barcode / library code</label><input class="form-control form-control-lg" id="itemCode" name="itemCode" value="@Model.ItemCode" placeholder="e.g. BK-1001 or TY-3006" required autocomplete="off" /><button class="btn btn-success btn-lg w-100 mt-3" type="submit">Confirm checkout</button></form></section></div>
  </div>
  @if (Model.Borrower != null) { <section class="kiosk-card mt-4"><div class="d-flex justify-content-between align-items-start flex-wrap gap-2"><div><div class="kiosk-step">ACCOUNT SUMMARY</div><h2 class="mb-1">Hello, @Model.Borrower.FullName</h2><p class="text-secondary mb-0">@Model.Borrower.Email</p></div><span class="badge text-bg-primary fs-6">@Model.ActiveLoans.Count active loan(s)</span></div><div class="table-responsive mt-3"><table class="table align-middle"><thead><tr><th>Item</th><th>Library code</th><th>Due date</th><th>Status</th></tr></thead><tbody>@if (!Model.ActiveLoans.Any()) { <tr><td colspan="4" class="text-secondary">You have no active loans.</td></tr> } else { @foreach (var loan in Model.ActiveLoans) { <tr><td>@loan.Item?.Name</td><td>@loan.Item?.LibraryCode</td><td>@loan.DueDate.ToString("dd MMM yyyy")</td><td>@(loan.DueDate.Date < DateTime.Today ? "Overdue" : "On loan")</td></tr> } }</tbody></table></div></section> }
  <div class="kiosk-footer"><span>Touch-friendly self-service · Transactions are recorded in the library system</span><form asp-controller="Kiosk" asp-action="Done" method="post" class="m-0"><button class="btn btn-outline-secondary" type="submit">Done · Sign out</button></form></div>
</div>
