@model IEnumerable<LibraryManagementSystem.Models.BorrowRecord>

@*
    Reception/Admin loan management page (BorrowRecordController.Index).
    Lists every loan, active and completed, with quick actions to return
    an active loan or edit its dates.
*@

@{
    ViewData["Title"] = "Borrow / Return Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Borrow & Return Records</h1>
    <a asp-action="Create" class="btn btn-primary">Issue New Item</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Item</th>
            <th>Borrower</th>
            <th>Borrow Date</th>
            <th>Due Date</th>
            <th>Return Date</th>
            <th>Fine ($)</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@(item.Item?.Name ?? "N/A")</td>
                <td>@(item.Borrower?.FullName ?? "N/A")</td>
                <td>@item.BorrowDate.ToString("yyyy-MM-dd")</td>
                <td>@item.DueDate.ToString("yyyy-MM-dd")</td>
                <td>
                    @* ReturnDate is null while the loan is still active - that flag
                       drives every "is this loan finished?" decision in this view. *@
                    @if (item.ReturnDate.HasValue)
                    {
                        <span class="badge bg-success">@item.ReturnDate.Value.ToString("yyyy-MM-dd")</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Active</span>
                    }
                </td>
                <td>$@item.FineAmount.ToString("F2")</td>
                <td>
                    @* Only active loans can be returned; completed ones just show a label. *@
                    @if (!item.ReturnDate.HasValue)
                    {
                        <form asp-action="ReturnItem" asp-route-id="@item.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-outline-success">Mark Returned</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted">Completed</span>
                    }
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>
