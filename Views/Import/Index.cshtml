@model IEnumerable<LibraryManagementSystem.Models.ImportJob>
@{
    ViewData["Title"] = "Data Importer";
}

<h1>Data Importer</h1>

@if (TempData["ImportError"] != null)
{
    <div class="alert alert-danger">@TempData["ImportError"]</div>
}
@if (TempData["ImportSuccess"] != null)
{
    <div class="alert alert-success">@TempData["ImportSuccess"]</div>
}

<form asp-action="Upload" method="post" enctype="multipart/form-data" class="mb-4">
    <div class="form-group mb-2">
        <label>CSV file</label>
        <input type="file" name="file" accept=".csv" class="form-control" required />
    </div>
    <div class="form-group mb-2">
        <label>Duplicate policy</label>
        <select name="duplicatePolicy" class="form-control">
            <option value="Skip">Skip</option>
            <option value="Update">Update</option>
            <option value="Fail">Fail</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Upload &amp; Import</button>
</form>

<h4>Past Imports</h4>
<table class="table table-striped">
    <thead><tr><th>Date</th><th>Source</th><th>Rows</th><th>Success</th><th>Errors</th><th>By</th></tr></thead>
    <tbody>
        @foreach (var j in Model)
        {
            <tr>
                <td>@j.PerformedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@j.Source</td>
                <td>@j.RowCount</td>
                <td>@j.SuccessCount</td>
                <td>@j.ErrorCount</td>
                <td>@j.PerformedByEmail</td>
            </tr>
        }
    </tbody>
</table>