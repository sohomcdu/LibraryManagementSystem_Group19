@model IEnumerable<LibraryManagementSystem.Models.Item>

@*
    Public catalogue search page (SearchController.Index).
    No login required - this is the "search from your phone" portal
    requirement. Shows Books, Music, and Toys together as cards, with a
    "Request to Borrow" button only for signed-in Members.
*@

@{
    ViewData["Title"] = "Search Catalogue";
}

<h1>Search the Catalogue</h1>

<form asp-action="Index" method="get" class="row g-2 mb-4">
    <div class="col-auto flex-grow-1">
        <input type="text" name="query" value="@ViewData["Query"]" class="form-control"
               placeholder="Search by name, library code, or description" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

@if (!Model.Any())
{
    <p class="text-muted">No items found. Try a different search, or leave it blank to browse everything.</p>
}

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var item in Model)
    {
        @* Pattern-match on the concrete subclass to pick a display label,
           since Model is a mixed list of Book/Music/Toy queried through
           the shared abstract Item type. *@
        var typeLabel = item switch
        {
            Book => "Book",
            Music => "Music",
            Toy => "Toy",
            _ => "Item"
        };

        @* Colour-code the status badge so availability is scannable at a glance. *@
        var statusBadge = item.Status switch
        {
            "Available" => "bg-success",
            "Borrowed" => "bg-warning text-dark",
            "Damaged" => "bg-danger",
            _ => "bg-secondary"
        };

        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <span class="badge bg-secondary mb-2">@typeLabel</span>
                    <span class="badge @statusBadge mb-2">@item.Status</span>
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text text-muted small">@item.LibraryCode</p>
                    <p class="card-text">@item.Description</p>

                    @* Show the subclass-specific fields (Author/Genre, Artist/ReleaseYear, Type/MinimumAge). *@
                    @if (item is Book book)
                    {
                        <p class="card-text small">by @book.Author &mdash; @book.Genre</p>
                    }
                    else if (item is Music music)
                    {
                        <p class="card-text small">@music.Artist (@music.ReleaseYear)</p>
                    }
                    else if (item is Toy toy)
                    {
                        <p class="card-text small">Ages @toy.MinimumAge+ &mdash; @toy.Type</p>
                    }

                    @* Only offer the borrow-request action for items that are actually
                       available, and only to signed-in Members (not even for the administrative accounts); everyone else sees a
                       prompt to create an account instead of a broken/hidden button. *@
                    @if (item.Status == "Available")
                    {
                        @if (User.IsInRole("Member"))
                        {
                            <a asp-controller="BorrowRequest" asp-action="Create" asp-route-itemId="@item.Id"
                               class="btn btn-sm btn-primary mt-2">Request to Borrow</a>
                        }
                        else
                        {
                            <p class="text-muted small mt-2 mb-0">You need a member user account to access this feature.</p>
                        }
                    }
                </div>
            </div>
        </div>
    }
</div>
