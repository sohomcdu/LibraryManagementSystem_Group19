@*
    Public homepage (HomeController.Index). The very first page any
    visitor sees - no login required. Provides three shortcuts covering
    the app's three entry points: searching without an account, becoming
    a Member, and staff login.
*@

@{
    ViewData["Title"] = "Home";
}

<div class="text-center mb-4">
    <img src="https://images.unsplash.com/photo-1521587760476-6c12a4b040da?auto=format&fit=crop&w=1200&q=80"
         alt="Library bookshelves"
         class="img-fluid rounded shadow-sm mb-4"
         style="max-height: 320px; width: 100%; object-fit: cover;" />

    <h1>Welcome to the Library Management System</h1>
    <p class="lead text-muted">
        Browse our catalogue of books, music, and toys, and manage borrowing all in one place.
    </p>
</div>

<div class="row row-cols-1 row-cols-md-3 g-4 mt-2">
    <div class="col">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">Search the Catalogue</h5>
                <p class="card-text">Browse available books, music, and toys — no account needed.</p>
                <a asp-controller="Search" asp-action="Index" class="btn btn-primary">Search Now</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">Become a Member</h5>
                <p class="card-text">Register for a free account to request items and track your borrowing history.</p>
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary">Register</a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 text-center">
            <div class="card-body">
                <h5 class="card-title">Staff Login</h5>
                <p class="card-text">Admin, Reception, and Manager accounts can log in to manage the library.</p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">Log In</a>
            </div>
        </div>
    </div>
</div>
