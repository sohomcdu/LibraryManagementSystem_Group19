@*
    Login form (AccountController.Login). Works for every role - Admin,
    Reception, Manager, and Member all sign in through this same page;
    the role attached to their account determines what they can access
    afterward via [Authorize(Roles = "...")] on each controller.
*@

@{
    ViewData["Title"] = "Log in";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="mb-4">Log in</h1>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger" role="alert">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" required autofocus />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary">Log in</button>
        </form>

        <p class="mt-3">
            Don't have an account? <a asp-controller="Account" asp-action="Register">Register now</a>
        </p>

        <hr />
        <p class="text-muted small">
            Seeded test accounts: admin@library.local / Admin@12345,
            reception@library.local / Reception@12345,
            manager@library.local / Manager@12345
        </p>
    </div>
</div>
