@*
    Shown when a signed-in user's role doesn't have permission for the
    page they tried to reach (AccountController.AccessDenied), e.g. a
    Member trying to open an Admin-only CRUD page.
*@

@{
    ViewData["Title"] = "Access Denied";
}

<h1>Access denied</h1>
<p>You don't have permission to view this page. Try logging in with an account that has the right role.</p>
