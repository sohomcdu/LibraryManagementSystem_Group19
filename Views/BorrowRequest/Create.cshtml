@*
    Member's "request an item" form (BorrowRequestController.Create).
    Submits only an itemId - this is a request, not an actual loan, so no
    dates are collected here; Reception sets the due date when they approve it.
*@

@{
    ViewData["Title"] = "Request an Item";
}

<h1>Request an Item</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label class="control-label">Item</label>
                <select name="itemId" class="form-control" asp-items="ViewBag.ItemId">
                    <option value="">-- Select an item --</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Send Request</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>
