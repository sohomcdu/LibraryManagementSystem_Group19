@model IEnumerable<LibraryManagementSystem.Models.BorrowRequest>

@*
    Reception's request queue (BorrowRequestController.Pending).
    Shows every request across all Members still awaiting a decision,
    with Approve/Reject actions right on this page.
*@

@{
    ViewData["Title"] = "Pending Requests";
}

<h1>Pending Requests</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Item</th>
            <th>Requested By</th>
            <th>Requested On</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@(r.Item?.Name ?? "N/A")</td>
                <td>@(r.Borrower?.FullName ?? "N/A")</td>
                <td>@r.RequestDate.ToString("yyyy-MM-dd")</td>
                <td>
                    @* Two separate forms/buttons since Approve and Reject are
                       different POST actions with different side effects. *@
                    <form asp-action="Approve" asp-route-id="@r.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-success">Approve</button>
                    </form>
                    <form asp-action="Reject" asp-route-id="@r.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
