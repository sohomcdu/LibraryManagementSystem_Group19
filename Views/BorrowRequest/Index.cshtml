@model IEnumerable<LibraryManagementSystem.Models.BorrowRequest>

@*
    "My Requests" page for a signed-in Member (BorrowRequestController.Index).
    Shows only this Member's own requests, in every status, so they can see
    what's still pending versus already decided.
*@

@{
    ViewData["Title"] = "My Requests";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>My Requests</h1>
    <a asp-action="Create" class="btn btn-primary">Request an Item</a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <h4>You haven't requested anything yet</h4>
        <p class="text-muted">
            Browse the catalogue and request an item — Reception will approve it
            and you'll see it here.
        </p>
        <a asp-controller="Search"
           asp-action="Index"
           class="btn btn-primary">
            Search the Catalogue
        </a>
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Item</th>
                <th>Requested On</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@(r.Item?.Name ?? "N/A")</td>
                    <td>@r.RequestDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        @{
                            // Colour-code the status badge: green for approved,
                            // red for rejected, amber for still pending.
                            var badgeClass = r.Status switch
                            {
                                "Approved" => "bg-success",
                                "Rejected" => "bg-danger",
                                _ => "bg-warning text-dark"
                            };
                        }
                        <span class="badge @badgeClass">@r.Status</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
