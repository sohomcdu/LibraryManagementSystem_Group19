@model IEnumerable<LibraryManagementSystem.Models.ApiKey>
@{ ViewData["Title"] = "REST API keys"; }
<section class="lh-section-head"><div><div class="lh-eyebrow">INTEGRATIONS</div><h1>REST API keys</h1><p class="text-secondary">Create credentials for trusted read-only catalogue integrations. Keys are stored as hashes and shown only once.</p></div></section>
@if (TempData["NewApiKey"] is string newKey) { <div class="alert alert-warning"><strong>Copy this key now:</strong><code class="d-block mt-2 text-break">@newKey</code><button type="button" class="btn btn-sm btn-outline-dark mt-2" onclick="navigator.clipboard.writeText('@newKey')">Copy key</button></div> }
<div class="card p-4 mb-4"><h2 class="h5">Create a key</h2><form asp-action="Create" method="post" class="row g-3 align-items-end"><div class="col-md-8"><label class="form-label" for="clientName">Client / integration name</label><input class="form-control" id="clientName" name="clientName" maxlength="100" required placeholder="e.g. University catalogue app" /></div><div class="col-md-4"><button class="btn btn-primary w-100" type="submit">Generate API key</button></div></form></div>
<div class="card p-3"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Client</th><th>Created (UTC)</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var key in Model) { <tr><td>@key.ClientName</td><td>@key.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td><td><span class="badge @(key.IsActive ? "text-bg-success" : "text-bg-secondary")">@(key.IsActive ? "Active" : "Revoked")</span></td><td class="text-end">@if (key.IsActive) { <form asp-action="Revoke" method="post" class="d-inline"><input type="hidden" name="id" value="@key.Id"/><button class="btn btn-sm btn-outline-danger" type="submit">Revoke</button></form> }</td></tr> }</tbody></table></div></div>
<section class="card p-4 mt-4"><h2 class="h5">Read-only API endpoints</h2><p class="mb-1"><code>GET /api/v1/items?q=clean&amp;category=book&amp;branch=CEN</code></p><p class="mb-1"><code>GET /api/v1/categories</code></p><p class="mb-1"><code>GET /api/v1/status</code></p><p class="text-secondary small mb-0">Send the key in the <code>X-API-Key</code> request header. The existing anonymous <code>/api/public/*</code> endpoints remain read-only and available without a key.</p></section>
