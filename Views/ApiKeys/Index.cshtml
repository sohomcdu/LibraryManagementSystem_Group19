@model IEnumerable<LibraryManagementSystem.Models.ApiKey>
@{ ViewData["Title"] = "REST API keys"; }

<section class="lh-section-head">
    <div>
        <div class="lh-eyebrow">INTEGRATIONS</div>
        <h1>REST API keys</h1>
        <p class="text-secondary">Create credentials for trusted read-only catalogue integrations. Keys are stored as hashes and shown only once.</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a class="btn btn-outline-primary" asp-controller="ApiDocs" asp-action="Index">API documentation</a>
        <a class="btn btn-outline-secondary" asp-controller="ApiUsage" asp-action="Index">API usage report</a>
    </div>
</section>

@if (TempData["NewApiKey"] is string newKey)
{
    <div class="alert alert-warning">
        <strong>Copy this key now:</strong>
        <code class="d-block mt-2 text-break" id="newKeyValue">@newKey</code>
        <button type="button" class="btn btn-sm btn-outline-dark mt-2" onclick="navigator.clipboard.writeText(document.getElementById('newKeyValue').textContent)">Copy key</button>
        <button type="button" class="btn btn-sm btn-dark mt-2" onclick="document.getElementById('tryKey').value = document.getElementById('newKeyValue').textContent">Use in the tester below</button>
    </div>
}

<div class="card p-4 mb-4">
    <h2 class="h5">Create a key</h2>
    <form asp-action="Create" method="post" class="row g-3 align-items-end">
        <div class="col-md-8">
            <label class="form-label" for="clientName">Client / integration name</label>
            <input class="form-control" id="clientName" name="clientName" maxlength="100" required placeholder="e.g. University catalogue app" />
        </div>
        <div class="col-md-4"><button class="btn btn-primary w-100" type="submit">Generate API key</button></div>
    </form>
</div>

<div class="card p-3 mb-4">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr><th>Client</th><th>Created</th><th>Last used</th><th class="text-end">Requests</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-secondary">No API keys yet. Create one above.</td></tr>
                }
                @foreach (var key in Model)
                {
                    <tr>
                        <td>@key.ClientName</td>
                        <td>@key.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td>@(key.LastUsedAt.HasValue ? key.LastUsedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm") : "Never")</td>
                        <td class="text-end">@key.RequestCount</td>
                        <td><span class="badge @(key.IsActive ? "text-bg-success" : "text-bg-secondary")">@(key.IsActive ? "Active" : "Revoked")</span></td>
                        <td class="text-end">
                            @if (key.IsActive)
                            {
                                <form asp-action="Revoke" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@key.Id" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Revoke</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<section class="card p-4">
    <h2 class="h5">Try the API</h2>
    <p class="text-secondary small">Send a real request with a key to check it works. A missing, wrong or revoked key returns <strong>401</strong>.</p>
    <div class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label" for="tryKey">API key (X-API-Key)</label>
            <input class="form-control" id="tryKey" placeholder="Paste a key, or leave empty to see a 401" autocomplete="off" />
        </div>
        <div class="col-md-5">
            <label class="form-label" for="tryPath">Endpoint</label>
            <select class="form-select" id="tryPath">
                <option value="/api/v1/status">GET /api/v1/status</option>
                <option value="/api/v1/items?pageSize=5">GET /api/v1/items?pageSize=5</option>
                <option value="/api/v1/items?type=music">GET /api/v1/items?type=music</option>
                <option value="/api/v1/items?branch=NTH&amp;type=toy">GET /api/v1/items?branch=NTH&amp;type=toy</option>
                <option value="/api/v1/items/1">GET /api/v1/items/1</option>
                <option value="/api/v1/categories">GET /api/v1/categories</option>
                <option value="/api/v1/branches">GET /api/v1/branches</option>
            </select>
        </div>
        <div class="col-md-2"><button type="button" class="btn btn-primary w-100" id="tryButton">Send</button></div>
    </div>
    <div class="mt-3">
        <div class="small fw-semibold" id="tryStatus"></div>
        <pre class="bg-light border rounded p-3 mt-2 mb-0 small" id="tryOutput" style="max-height:360px;overflow:auto;white-space:pre-wrap">Response will appear here.</pre>
    </div>
</section>

@section Scripts {
    <script>
        document.getElementById('tryButton').addEventListener('click', async function () {
            const key = document.getElementById('tryKey').value.trim();
            const path = document.getElementById('tryPath').value;
            const status = document.getElementById('tryStatus');
            const output = document.getElementById('tryOutput');
            status.textContent = 'Sending…';
            try {
                const headers = key ? { 'X-API-Key': key } : {};
                const response = await fetch(path, { headers: headers });
                const text = await response.text();
                status.textContent = 'HTTP ' + response.status + ' ' + response.statusText;
                status.className = 'small fw-semibold ' + (response.ok ? 'text-success' : 'text-danger');
                try { output.textContent = JSON.stringify(JSON.parse(text), null, 2); }
                catch { output.textContent = text; }
            } catch (err) {
                status.textContent = 'Request failed';
                output.textContent = String(err);
            }
        });
    </script>
}
