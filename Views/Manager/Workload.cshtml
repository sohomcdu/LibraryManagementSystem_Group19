@model LibraryManagementSystem.Models.ManagerWorkloadViewModel
@{
    ViewData["Title"] = "Workload & backlog";
}

<section class="lh-section-head d-flex justify-content-between align-items-start flex-wrap gap-3">
    <div>
        <div class="lh-eyebrow">Manager reports · @Model.BranchName</div>
        <h1>Workload &amp; backlog</h1>
        <p>Compare service activity across dates and find unresolved work that needs follow-up.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to dashboard</a>
</section>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
}

<form asp-action="Workload" method="get" class="card p-3 mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-sm-4 col-lg-3">
            <label for="fromDate" class="form-label">From date</label>
            <input id="fromDate" name="fromDate" type="date" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control" required />
        </div>
        <div class="col-sm-4 col-lg-3">
            <label for="toDate" class="form-label">To date</label>
            <input id="toDate" name="toDate" type="date" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control" required />
        </div>
        <div class="col-sm-4 col-lg-3">
            <button type="submit" class="btn btn-primary w-100">Apply date range</button>
        </div>
        <div class="col-lg-3">
            <a asp-action="ExportWorkloadCsv" asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")" class="btn btn-outline-primary w-100">Download CSV</a>
        </div>
    </div>
    <p class="form-text mb-0 mt-2">Activity is grouped by its recorded event date. Backlog shows unresolved records created or due within this range.</p>
</form>

<section class="card p-3 mb-4">
    <h2 class="h4">Activity summary</h2>
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead><tr><th>Activity</th><th class="text-end">Total in range</th><th class="text-end">Still unresolved</th></tr></thead>
            <tbody>
            @foreach (var row in Model.Activity)
            {
                <tr><th scope="row">@row.Activity</th><td class="text-end">@row.Total</td><td class="text-end">@row.Unresolved</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>

<section class="card p-3">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
        <div><h2 class="h4 mb-1">Backlog to follow up</h2><p class="text-secondary">Items are ordered with the oldest first. Age is measured from request, transfer, or due date.</p></div>
        <span class="badge text-bg-warning">@Model.Backlog.Count open item(s)</span>
    </div>
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead><tr><th>Type</th><th>Reference</th><th>Description</th><th>Status</th><th>Created / due</th><th class="text-end">Age (days)</th></tr></thead>
            <tbody>
            @if (Model.Backlog.Count == 0)
            {
                <tr><td colspan="6" class="text-secondary">No unresolved work was found in this date range.</td></tr>
            }
            else
            {
                @foreach (var row in Model.Backlog)
                {
                    <tr><td>@row.Type</td><td>@row.Reference</td><td>@row.Description</td><td>@row.Status</td><td>@row.CreatedAt.ToString("yyyy-MM-dd")</td><td class="text-end">@row.AgeDays</td></tr>
                }
            }
            </tbody>
        </table>
    </div>
</section>
