@model IEnumerable<LibraryManagementSystem.Models.Reservation>
@{
    ViewData["Title"] = "Holds & Waitlist";
}

<h1>Holds & Waitlist</h1>

<table class="table table-striped">
    <thead><tr><th>Item</th><th>Borrower</th><th>Requested</th><th>Status</th><th>Pickup By</th><th></th></tr></thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@(r.Item?.Name ?? "N/A")</td>
                <td>@(r.Borrower?.FullName ?? "N/A")</td>
                <td>@r.RequestedDate.ToString("yyyy-MM-dd")</td>
                <td>
                    <span class="badge @(r.Status == "Ready" ? "bg-success" : "bg-warning text-dark")">@r.Status</span>
                </td>
                <td>@(r.PickupExpiresAt?.ToString("yyyy-MM-dd") ?? "-")</td>
                <td>
                    @if (r.Status == "Ready")
                    {
                        <form asp-action="Fulfil" asp-route-id="@r.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-success">Hand Over Item</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>