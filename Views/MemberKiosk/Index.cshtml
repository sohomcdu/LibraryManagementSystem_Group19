@model LibraryManagementSystem.Models.MemberKioskViewModel
@* Member self-service kiosk (MemberKioskController). The member is already signed in, so no email is needed. *@
@{ ViewData["Title"] = "Self-Service Kiosk"; }
<div class="kiosk-shell">
  <div class="kiosk-top">
    <div>
      <span class="kiosk-eyebrow">MEMBER SELF-SERVICE</span>
      <h1>Self-Service Kiosk</h1>
      <p>Borrow an item yourself by scanning or typing its library code, and check your loans.</p>
    </div>
    <a class="btn btn-outline-light btn-lg" asp-controller="Search" asp-action="Index">Browse catalogue</a>
  </div>

  @if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="alert alert-warning mt-4" role="alert">@Model.Error</div> }
  @if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert alert-success mt-4" role="status">@Model.Message</div> }

  <div class="row g-4 mt-1">
    <div class="col-lg-7">
      <section class="kiosk-card">
        <div class="kiosk-step">BORROW AN ITEM</div>
        <h2>Scan item code</h2>
        <form asp-controller="MemberKiosk" asp-action="Checkout" method="post">
          <label class="form-label" for="branchCode">I am at</label>
          <select class="form-select form-select-lg mb-3" id="branchCode" name="branchCode" required>
            @foreach (var b in Model.Branches)
            {
              <option value="@b.Code" selected="@(b.Code == Model.BranchCode)">@b.Name</option>
            }
          </select>
          <label class="form-label" for="itemCode">Item barcode / library code</label>
          <input class="form-control form-control-lg" id="itemCode" name="itemCode" value="@Model.ItemCode" placeholder="e.g. BK-1001 or TY-3006" required autocomplete="off" autofocus />
          <button class="btn btn-success btn-lg w-100 mt-3" type="submit">Confirm checkout</button>
        </form>
        <p class="small text-secondary mt-3 mb-0">You can only borrow items held at the branch you are in. Loans are for 14 days.</p>
      </section>
    </div>
    <div class="col-lg-5">
      <section class="kiosk-card">
        <div class="kiosk-step">YOUR ACCOUNT</div>
        <h2>Hello, @Model.Borrower?.FullName</h2>
        <p class="text-secondary mb-3">@Model.Borrower?.Email</p>
        <p class="mb-2"><span class="badge text-bg-primary fs-6">@Model.ActiveLoans.Count active loan(s)</span></p>
        <a class="btn btn-outline-primary w-100" asp-controller="Me" asp-action="Index">Open My Library</a>
      </section>
    </div>
  </div>

  <section class="kiosk-card mt-4">
    <div class="kiosk-step">ACCOUNT SUMMARY</div>
    <h2 class="mb-1">Your current loans</h2>
    <div class="table-responsive mt-3">
      <table class="table align-middle">
        <thead><tr><th>Item</th><th>Library code</th><th>Branch</th><th>Due date</th><th>Status</th></tr></thead>
        <tbody>
        @if (!Model.ActiveLoans.Any())
        {
          <tr><td colspan="5" class="text-secondary">You have no active loans.</td></tr>
        }
        else
        {
          @foreach (var loan in Model.ActiveLoans)
          {
            <tr>
              <td>@loan.Item?.Name</td>
              <td>@loan.Item?.LibraryCode</td>
              <td>@loan.Item?.Branch?.Name</td>
              <td>@loan.DueDate.ToString("dd MMM yyyy")</td>
              <td>@(loan.DueDate.Date < DateTime.Today ? "Overdue" : "On loan")</td>
            </tr>
          }
        }
        </tbody>
      </table>
    </div>
  </section>

  <div class="kiosk-footer">
    <span>Self-service · Transactions are recorded in the library system</span>
    <a asp-controller="Me" asp-action="Index">Back to My Library</a>
  </div>
</div>
