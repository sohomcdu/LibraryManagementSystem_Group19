@model IEnumerable<LibraryManagementSystem.Models.Branch>
@{
    ViewData["Title"] = "Branches";
}

<h1>Branches</h1>
<p><a asp-action="Create" class="btn btn-primary">Add Branch</a></p>
<table class="table table-striped">
    <thead><tr><th>Code</th><th>Name</th><th>Address</th><th>Active</th><th></th></tr></thead>
    <tbody>
        @foreach (var b in Model)
        {
            <tr>
                <td>@b.Code</td>
                <td>@b.Name</td>
                <td>@b.Address</td>
                <td>@(b.IsActive ? "Yes" : "No")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@b.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@b.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>