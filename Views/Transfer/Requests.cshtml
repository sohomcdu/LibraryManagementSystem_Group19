@model IReadOnlyList<LibraryManagementSystem.Models.TransferRequestReviewRow>
@{
    ViewData["Title"] = "Transfer Requests";
}

<section class="lh-section-head">
    <div>
        <div class="lh-eyebrow">Manager review</div>
        <h1>Branch transfer requests</h1>
        <p>Check currently available stock at the source branch before approving a request.</p>
    </div>
</section>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead><tr><th>Category and selected copies</th><th>Qty requested</th><th>Selected copies still available</th><th>From</th><th>To</th><th>Requested</th><th>Requested by</th><th>Status / decision</th></tr></thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="8" class="text-secondary">No transfer requests have been submitted.</td></tr>
            }
            @foreach (var row in Model)
            {
                var request = row.Request;
                <tr>
                    <td>
                        @(request.ItemCategory switch { "Book" => "Books", "Music" => "Music", "Toy" => "Toys", _ => request.ItemCategory })
                        @if (request.RequestedItems.Count > 0)
                        {
                            <ul class="small mb-0 ps-3 mt-1">
                                @foreach (var selected in request.RequestedItems)
                                {
                                    <li>
                                        @if (selected.Item is not null)
                                        {
                                            <span>@selected.Item.Name — ID @selected.Item.Id · @selected.Item.LibraryCode</span>
                                        }
                                        else
                                        {
                                            <span>Item ID @selected.ItemId</span>
                                        }
                                        @if (selected.Item?.Status != "Available" || selected.Item?.BranchId != request.FromBranchId)
                                        {
                                            <span class="text-danger">(no longer available at source)</span>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <small class="d-block text-secondary">Legacy request: any matching available copies</small>
                        }
                    </td>
                    <td>@request.Quantity</td>
                    <td>
                        <strong class="@(row.SelectedAvailable >= request.Quantity ? "text-success" : "text-danger")">@row.SelectedAvailable</strong>
                        @if (request.Status == "Pending" && row.SelectedAvailable < request.Quantity)
                        {
                            <small class="d-block text-danger">Insufficient stock</small>
                        }
                    </td>
                    <td>@(request.FromBranch?.Name ?? "N/A")</td>
                    <td>@(request.ToBranch?.Name ?? "N/A")</td>
                    <td>@request.RequestedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@request.RequestedBy</td>
                    <td>
                        @if (request.Status == "Pending")
                        {
                            <div class="d-flex gap-2">
                                <form asp-action="Approve" asp-route-id="@request.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-success" disabled="@(row.SelectedAvailable < request.Quantity)">Approve</button>
                                </form>
                                <form asp-action="Reject" asp-route-id="@request.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <span class="badge @(request.Status == "Approved" ? "bg-success" : "bg-danger")">@request.Status</span>
                            <small class="d-block text-secondary">@(request.ReviewedBy ?? "Manager") · @request.ReviewedAt?.ToString("yyyy-MM-dd HH:mm")</small>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
