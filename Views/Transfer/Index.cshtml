@model IEnumerable<LibraryManagementSystem.Models.ItemTransfer>
@{
    ViewData["Title"] = "Transfers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Item Transfers</h1>
    <a asp-action="Create" class="btn btn-primary">Start a Transfer</a>
</div>

<table class="table table-striped">
    <thead><tr><th>Item</th><th>From</th><th>To</th><th>Initiated</th><th>Status</th><th></th></tr></thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td>@(t.Item?.Name ?? "N/A")</td>
                <td>@(t.FromBranch?.Code ?? "N/A")</td>
                <td>@(t.ToBranch?.Code ?? "N/A")</td>
                <td>@t.InitiatedDate.ToString("yyyy-MM-dd")</td>
                <td>
                    @if (t.Status == "InTransit")
                    {
                        <span class="badge bg-warning text-dark">In Transit</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Completed (@t.ReceivedDate?.ToString("yyyy-MM-dd"))</span>
                    }
                </td>
                <td>
                    @if (t.Status == "InTransit")
                    {
                        <form asp-action="Receive" asp-route-id="@t.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-outline-success">Mark Received</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>