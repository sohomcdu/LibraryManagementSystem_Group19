@model IEnumerable<LibraryManagementSystem.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Notification Dashboard</h1>
    <form asp-action="RunSweep" method="post">
        <button type="submit" class="btn btn-outline-primary">Run Due-Date Sweep</button>
    </form>
</div>

<table class="table table-striped">
    <thead><tr><th>Sent</th><th>Type</th><th>Channel</th><th>Recipient</th><th>Subject</th></tr></thead>
    <tbody>
        @foreach (var n in Model)
        {
            <tr>
                <td>@n.SentAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@n.Type</td>
                <td>@n.Channel</td>
                <td>@n.Recipient</td>
                <td>@n.Subject</td>
            </tr>
        }
    </tbody>
</table>