@page
@model LibraHub.Pages.Me.FinesModel
@{ ViewData["Title"] = "My fines"; ViewData["Nav"] = "me"; ViewData["Tab"] = "fines"; }
<div class="container">
    <h1>Hi @User.DisplayName().Split(' ')[0]</h1>
    <partial name="Me/_MeTabs" />
    <div class="card">
        <h3>Fines <span class="badge @(Model.Outstanding>0?"b-red":"b-green")">@Fmt.Money(Model.Outstanding) outstanding</span></h3>
        @if (Model.Items.Count == 0) { <p class="muted">No fines on your account. Nice!</p> }
        else
        {
            <div class="table-wrap"><table>
                <thead><tr><th>Item</th><th>Days late</th><th>Amount</th><th>Status</th><th>Issued</th></tr></thead>
                <tbody>
                @foreach (var f in Model.Items)
                {
                    <tr><td>@f.Loan.Item.Title</td><td>@f.DaysLate</td><td>@Fmt.Money(f.AmountCents)</td>
                        <td><span class="badge @(f.Status==FineStatus.Outstanding?"b-red":f.Status==FineStatus.Waived?"b-grey":"b-green")">@f.Status</span></td>
                        <td>@Fmt.Day(f.IssuedAt)</td></tr>
                }
                </tbody></table></div>
            <p class="small muted" style="margin-top:.6rem">Fines are collected or waived at the reception desk.</p>
        }
    </div>
</div>
