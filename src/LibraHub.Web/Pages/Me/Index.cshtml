@page
@model LibraHub.Pages.Me.IndexModel
@{ ViewData["Title"] = "My Library"; ViewData["Nav"] = "me"; ViewData["Tab"] = "loans"; var p = Model.Patron; }
<div class="container">
    <h1>Hi @p.FullName.Split(' ')[0]</h1>
    <p class="muted">Patron since @p.CreatedAt.ToString("MMM yyyy") · Home branch: @p.HomeBranch?.Name?.Replace(" Library", "")</p>
    <div class="grid g2" style="align-items:center;margin-bottom:1rem">
        <div></div>
        <div class="cardbox">
            <div><div class="small muted">Library card</div><div style="font-size:1.2rem;font-weight:700">@p.CardNumber</div></div>
            <div class="grow">@Html.Raw(LibraHub.Infrastructure.Barcode.Svg(p.CardNumber ?? ""))</div>
        </div>
    </div>
    <div class="grid g4">
        <div class="kpi"><div class="l">On loan</div><div class="v">@Model.Loans.Count</div><div class="s">limit 5 items</div></div>
        <div class="kpi"><div class="l">Holds</div><div class="v">@Model.Holds</div><div class="s">@Model.ReadyHolds ready for pickup</div></div>
        <div class="kpi"><div class="l">Fines due</div><div class="v" style="color:@(Model.FineCents>0?"var(--red)":"var(--navy)")">@Fmt.Money(Model.FineCents)</div><div class="s">@Model.OverdueCount overdue item@(Model.OverdueCount==1?"":"s")</div></div>
        <div class="kpi"><div class="l">Unread messages</div><div class="v">@Model.UnreadCount</div><div class="s">simulated email/SMS</div></div>
    </div>
    <partial name="Me/_MeTabs" />
    <partial name="_Flash" />
    <div class="grid g2" style="grid-template-columns:1fr 340px;align-items:start">
        <div class="card">
            <h3>Current loans</h3>
            @if (Model.Loans.Count == 0) { <p class="muted">No items on loan.</p> }
            else
            {
                <form method="post" asp-page-handler="Renew">
                <div class="table-wrap"><table>
                    <thead><tr><th></th><th>Item</th><th>Branch</th><th>Borrowed</th><th>Due</th><th>Status</th></tr></thead>
                    <tbody>
                    @foreach (var l in Model.Loans)
                    {
                        var days = (l.DueAt.Date - Clock.Today).Days;
                        <tr class="@(days<0?"hl":"")">
                            <td><input type="checkbox" name="SelectedLoans" value="@l.Id" /></td>
                            <td><strong>@l.Item.Title</strong></td><td>@l.Item.CurrentBranch.Name.Replace(" Library","").Replace(" Branch","")</td>
                            <td>@Fmt.Day(l.BorrowedAt)</td><td>@Fmt.Day(l.DueAt)</td>
                            <td>
                                @if (days < 0) { <span class="badge b-red">Overdue</span> <text>&nbsp;@(-days) days</text> }
                                else if (days == 0) { <span class="badge b-amber">Due soon</span> <text>&nbsp;today</text> }
                                else if (days <= 2) { <span class="badge b-amber">Due soon</span> <text>&nbsp;@days days left</text> }
                                else { <text>@days days left</text> }
                            </td>
                        </tr>
                    }
                    </tbody></table></div>
                <button class="btn" type="submit" style="margin-top:.8rem">Renew selected</button>
                <span class="small muted">Items with a waitlist cannot be renewed.</span>
                </form>
            }
        </div>
        <div class="card">
            <h3>Recent notifications</h3>
            @if (Model.Recent.Count == 0) { <p class="muted small">No notifications yet.</p> }
            @foreach (var n in Model.Recent)
            {
                <div class="notif"><span class="badge @(n.Type==NotificationType.Overdue?"b-red":n.Type==NotificationType.DueSoon?"b-amber":"b-green")">@n.Type</span>
                    &nbsp;“@n.Subject”<div class="small muted">@Fmt.Relative(n.CreatedAt) · @n.Channel</div></div>
            }
            <p style="margin-top:.6rem"><a href="/Me/Notifications">Manage preferences →</a></p>
        </div>
    </div>
</div>
