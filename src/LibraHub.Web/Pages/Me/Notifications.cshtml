@page
@model LibraHub.Pages.Me.NotificationsModel
@{ ViewData["Title"] = "My notifications"; ViewData["Nav"] = "me"; ViewData["Tab"] = "notif"; }
<div class="container">
    <h1>Hi @User.DisplayName().Split(' ')[0]</h1>
    <partial name="Me/_MeTabs" />
    <div class="card">
        <h3>Notifications (simulated email/SMS)</h3>
        @if (Model.Items.Count == 0) { <p class="muted">Nothing yet.</p> }
        @foreach (var n in Model.Items)
        {
            <div class="notif"><span class="badge b-blue">@n.Channel</span> <strong>@n.Subject</strong>
                <div class="small">@n.Body</div><div class="small muted">@Fmt.Relative(n.CreatedAt) · @n.Status</div></div>
        }
    </div>
</div>
