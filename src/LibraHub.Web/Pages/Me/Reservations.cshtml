@page
@model LibraHub.Pages.Me.ReservationsModel
@{ ViewData["Title"] = "My reservations"; ViewData["Nav"] = "me"; ViewData["Tab"] = "res"; }
<div class="container">
    <h1>Hi @((User.DisplayName() ?? "").Split(' ')[0])</h1>
    <partial name="Me/_MeTabs" />
    <partial name="_Flash" />
    <div class="card">
        <h3>Holds &amp; waitlist</h3>
        @if (Model.Items.Count == 0) { <p class="muted">You have no reservations. <a href="/Catalogue">Browse the catalogue</a>.</p> }
        else
        {
            <div class="table-wrap"><table>
                <thead><tr><th>Title</th><th>Status</th><th>Pickup branch</th><th>Placed</th><th></th></tr></thead>
                <tbody>
                @foreach (var r in Model.Items)
                {
                    <tr>
                        <td><strong>@r.TitleText</strong></td>
                        <td>
                            @if (r.Status == HoldStatus.Ready)
                            {
                                <span class="badge b-green">Ready</span>
                                <span class="small">until @(r.ExpiresAt.HasValue ? Fmt.Day(r.ExpiresAt.Value) : "-")@(string.IsNullOrEmpty(r.PickupCode) ? "" : (" · code " + r.PickupCode))</span>
                            }
                            else if (r.Status == HoldStatus.Waiting)
                            {
                                <span class="badge b-amber">Waiting</span>
                                <span class="small">#@Model.Positions.GetValueOrDefault(r.Id)</span>
                            }
                            else
                            {
                                <span class="badge b-grey">@r.Status</span>
                            }
                        </td>
                        <td>
                            @if (r.Status == HoldStatus.Waiting)
                            {
                                <form method="post" asp-page-handler="Branch" asp-route-id="@r.Id" class="row">
                                    <select name="branchId" data-autosubmit>
                                        @foreach (var b in Model.Branches) { <option value="@b.Id" selected="@(b.Id == r.PickupBranchId)">@b.Name</option> }
                                    </select>
                                </form>
                            }
                            else { @(r.PickupBranch?.Name ?? "Unknown") }
                        </td>
                        <td>@Fmt.Day(r.PlacedAt)</td>
                        <td>
                            @if (r.IsActive)
                            {
                                <form method="post" asp-page-handler="Cancel" asp-route-id="@r.Id" onsubmit="return confirm('Cancel this hold?')">
                                    <button class="btn btn-sm btn-danger" type="submit">Cancel</button></form>
                            }
                        </td>
                    </tr>
                }
                </tbody></table></div>
        }
    </div>
</div>
