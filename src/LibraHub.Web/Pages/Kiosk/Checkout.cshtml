@page
@model LibraHub.Pages.Kiosk.CheckoutModel
@{ ViewData["Title"] = "Check-out"; }
<div class="row spread">
    <div>
        <p class="muted">Signed in as</p>
        <h1>@Model.Patron!.FullName</h1>
    </div>
    <form method="post" asp-page-handler="Cancel">
        <button class="btn" type="submit">Cancel</button>
    </form>
</div>

<form method="post" asp-page-handler="Scan">
    <div class="scanbox" style="border-color:var(--teal)">
        <h3 style="text-align:center;color:var(--teal);margin:0">Scan the barcode on each item</h3>
        <p class="lead" style="margin:.3rem 0 1rem">Place the book's barcode under the scanner — it will be added below.</p>
        <input data-scan name="ItemCode" placeholder="Scan item..." autocomplete="off" />
    </div>
</form>

<h3>Your items (@Model.Basket.Count(b => b.Ok))</h3>
@foreach (var b in Model.Basket)
{
    <div class="row spread card" style="padding:.8rem 1.2rem;margin-bottom:.6rem">
        <div class="row">
            <partial name="_Cover" model="@(("#12324A,#0F766E", "sm"))" />
            <div>
                <strong>@b.Title</strong>
                <div class="small muted">@b.Code</div>
            </div>
        </div>
        <div class="right">
            <div>@(b.Due != null ? "Due " + Fmt.Day(b.Due.Value) : "")</div>
            <partial name="_Badge" model="b.Status" />
        </div>
    </div>
}

@if (Model.Blocked != null) { <div class="alert alert-error">"@Model.Blocked"</div> }

<div class="row" style="justify-content:space-between;margin-top:1.5rem">
    <a class="btn btn-lg" href="/Kiosk/Account">Cancel</a>
    <form method="post" asp-page-handler="Finish">
        <button class="btn btn-primary btn-lg" type="submit" disabled="@(Model.Basket.Count(b => b.Ok) == 0)">
            Finish check-out (@Model.Basket.Count(b => b.Ok) items) ›
        </button>
    </form>
</div>