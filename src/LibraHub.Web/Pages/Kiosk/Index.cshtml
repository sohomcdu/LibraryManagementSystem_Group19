@page
@model LibraHub.Pages.Kiosk.IndexModel
@{ ViewData["Title"] = "Welcome"; }
@if (Model.TimedOut) { <div class="alert alert-info">Session ended due to inactivity.</div> }
<h1>Welcome! Scan your library card</h1>
<p class="lead">Hold the barcode under the scanner, or type your card number.</p>
<partial name="_Flash" />
<form method="post">
    <div class="scanbox">
        <svg viewBox="0 0 300 70" style="width:100%;height:70px">@Html.Raw(LibraHub.Infrastructure.Barcode.Svg("LC20487731").Replace("<svg", "<svg preserveAspectRatio=\"none\" style=\"width:100%;height:56px\""))</svg>
        <div class="scanline"></div>
        <input data-scan name="Card" type="text" placeholder="LC-2048-____" autocomplete="off" />
    </div>
    <div class="keypad">
        @for (int n = 1; n <= 9; n++) { <button type="button" data-key="@n">@n</button> }
        <button type="button" data-key="0" style="grid-column:2">0</button>
    </div>
    <div class="row" style="justify-content:center;gap:1rem">
        <button class="btn" type="button" data-clear>Clear</button>
        <button class="btn btn-accent btn-lg" type="submit">Continue ›</button>
    </div>
</form>
<hr />
<div style="max-width:420px;margin:1rem auto;text-align:center">
    <p class="muted">Can't scan or don't have your card?</p>
    <form method="post" asp-page-handler="Manual">
        <input name="Manual" type="text" placeholder="Card number, email or name" style="width:100%" />
        <div style="margin-top:0.5rem"><button class="btn btn-accent" type="submit">Lookup</button></div>
    </form>
    <form method="post" asp-page-handler="Help" style="margin-top:0.75rem">
        <button class="btn" type="submit">Request staff assistance</button>
    </form>
</div>
