@page
@model LibraHub.Pages.Kiosk.ReceiptModel
@{ ViewData["Title"] = "Done"; ViewData["FootNote"] = "Notification logged: \"Borrow receipt\" (simulated email)"; }
<div style="text-align:center">
    <div style="width:90px;height:90px;border-radius:50%;background:#16A34A;color:#fff;font-size:3rem;display:inline-flex;align-items:center;justify-content:center;margin:1rem 0">✓</div>
    <h1>All done, @Model.Patron?.FullName?.Split(' ')[0]!</h1>
    <p class="lead">@Model.Loans.Count items checked out</p>
</div>
<div class="receipt">
    <h3>Your receipt</h3>
    <ul>
        <li><strong>Item</strong><strong>Due date</strong></li>
        @foreach (var l in Model.Loans) { <li>@l.Item.Title <span>@Fmt.DayLong(l.DueAt)</span></li> }
    </ul>
    <p class="small muted">Renew online or at any desk unless someone is waiting.</p>
</div>
<div class="row" style="justify-content:center;gap:1rem;margin-top:1rem">
    <label class="btn"><input type="checkbox" checked disabled /> Email receipt</label>
    <label class="btn"><input type="checkbox" disabled /> SMS receipt</label>
    <label class="btn"><input type="checkbox" disabled /> Print</label>
</div>
<form method="post" asp-page-handler="Done">
    <button class="btn btn-primary btn-block btn-lg" style="margin-top:1rem" type="submit" data-countdown="20" data-url="/Kiosk/Index" id="doneBtn">Done · signing out in <span data-countdown="20" data-url="/Kiosk/Index">20</span> s</button>
</form>
