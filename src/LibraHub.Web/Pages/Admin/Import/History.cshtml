@page
@model LibraHub.Pages.Admin.Import.HistoryModel
@{ ViewData["Title"] = "Import data"; ViewData["Nav"] = "import"; }
<div class="tabs">
    <a href="/Admin/Import/Csv">CSV upload</a><a href="/Admin/Import/Provider">Metadata provider (mock)</a><a class="active" href="/Admin/Import/History">Import history</a>
</div>
<div class="card">
    <div class="table-wrap"><table><thead><tr><th>Job</th><th>Source</th><th>By</th><th>When</th><th>Rows</th><th>Imported</th><th>Skipped</th><th>Errors</th></tr></thead><tbody>
    @foreach (var j in Model.Jobs)
    { <tr><td>#@j.Id</td><td>@j.Source</td><td>@j.UserName</td><td>@Fmt.Day(j.At)</td><td>@j.TotalRows</td><td>@j.Imported</td><td>@j.Skipped</td><td>@j.Errors</td></tr> }
    </tbody></table></div>
</div>
