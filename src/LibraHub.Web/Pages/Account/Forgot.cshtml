@page
@model LibraHub.Pages.Account.ForgotModel
@{ ViewData["Title"] = "Forgot password"; }
<div class="container" style="max-width:480px">
    <div class="card">
        <h2>Forgot password</h2>
        @if (Model.Sent)
        { <div class="alert alert-ok">If that email matches an account, a reset link has been sent (simulated — check Staff › Notifications).</div> }
        else
        {
            <form method="post"><label for="e">Email</label><input id="e" name="Email" type="email" required />
                <button class="btn btn-primary btn-block" type="submit">Send reset link</button></form>
        }
        <p><a href="/Account/Login">Back to sign in</a></p>
    </div>
</div>
