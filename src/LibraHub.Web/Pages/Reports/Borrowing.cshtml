@page
@model LibraHub.Pages.Reports.BorrowingModel
@{
    ViewData["Title"] = "Reports";
    ViewData["Nav"] = "reports";
    var r = Model.R;
    var max = r.PerMonth.Count == 0 ? 1 : r.PerMonth.Max(m => m.Count);
}
<partial name="Reports/_Tabs" />
<partial name="Reports/_FilterBar" />

<div class="grid g4">
    <div class="kpi">
        <div class="l">Total loans</div>
        <div class="v">@r.TotalLoans</div>
        <div class="s">@(r.TotalLoans >= r.PriorTotal ? "+" : "")@(r.PriorTotal == 0 ? 0 : Math.Round(100.0 * (r.TotalLoans - r.PriorTotal) / r.PriorTotal))% vs prior period</div>
    </div>
    <div class="kpi"><div class="l">Active borrowers</div><div class="v">@r.ActiveBorrowers</div></div>
    <div class="kpi"><div class="l">Avg loan length</div><div class="v">@r.AvgLoanDays d</div></div>
    <div class="kpi"><div class="l">Return on time</div><div class="v">@r.OnTimePct%</div></div>
</div>

<div class="grid g2" style="margin-top:1rem">
    <div class="card">
        <h3>Loans per month</h3>
        <div class="chart">
            <svg viewBox="0 0 420 160" xmlns="http://www.w3.org/2000/svg">
                @{
                    var pts = r.PerMonth
                        .Select((m, i) => (
                            x: 20 + i * (380.0 / Math.Max(1, r.PerMonth.Count - 1)),
                            y: 140 - 110.0 * m.Count / max))
                        .ToList();
                }
                <polyline points="@string.Join(" ", pts.Select(p => $"{p.x:0},{p.y:0}"))"
                          fill="none" stroke="#0F766E" stroke-width="3" />
                @foreach (var (p, m) in pts.Zip(r.PerMonth))
                {
                    <circle cx="@p.x" cy="@p.y" r="4" fill="#0F766E" />
                    <svg:text x="@p.x" y="@(p.y - 10)" font-size="11" text-anchor="middle" fill="#12324A">@m.Count</svg:text>
                    <svg:text x="@p.x" y="155" font-size="11" text-anchor="middle" fill="#64748B">@m.Label</svg:text>
                }
            </svg>
        </div>
    </div>

    <div class="card">
        <h3>Top borrowed items</h3>
        @{
            var tmax = r.Top.Count == 0 ? 1 : r.Top.Max(t => t.Loans);
        }
        @foreach (var t in r.Top)
        {
            <div class="bar-row">
                <span>@t.Title</span>
                <span class="bar" style="width:@(100.0 * t.Loans / tmax)%"></span>
                <span>@t.Loans</span>
            </div>
        }
    </div>
</div>