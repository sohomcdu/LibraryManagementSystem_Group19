@{
    var m = (LibraHub.Pages.Reports.ReportPageBase)ViewContext.ViewData.Model!;
    var basePage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
}
<form method="get" class="row spread" style="margin:0 0 1rem">
    <div class="row">
        <input type="date" name="from" value="@m.FromStr" />
        <span>–</span>
        <input type="date" name="to" value="@m.ToStr" />
        <select name="branch"><option value="">Branch: All</option>@foreach (var b in m.Branches){<option value="@b.Value" selected="@b.Selected">@b.Text</option>}</select>
        <select name="category"><option value="">Category: All</option>@foreach (var c in m.Categories){<option value="@c.Value" selected="@c.Selected">@c.Text</option>}</select>
        <button class="btn btn-sm" type="submit">Apply</button>
    </div>
    <div class="row">
        <a class="btn" href="@(basePage)?handler=Csv&@m.Qs()">⇓ Export CSV</a>
        <a class="btn btn-primary" href="@(basePage)?handler=Pdf&@m.Qs()">⇓ Export PDF</a>
    </div>
</form>
