@inject LibraHub.Infrastructure.BranchContext Branches
@{
    var branch = await Branches.CurrentAsync();
    var idle = ViewData["IdleSeconds"] as int? ?? 60;
    var idleTo = ViewData["IdleTo"] as string ?? "/Kiosk?timeout=1";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Kiosk") · LibraHub Kiosk</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="kiosk" id="kioskBody">
<header class="k-top">
    <span class="brand"><span class="logo"></span>LibraHub Kiosk</span>
    <div style="text-align:right"><strong>@branch.Name</strong><br /><span class="small" id="clock">@Clock.Now.ToString("ddd d MMM · h:mm tt", System.Globalization.CultureInfo.InvariantCulture)</span></div>
</header>
<div class="k-main">@RenderBody()</div>
<footer class="k-foot">
    <span>@(ViewData["FootNote"] ?? "Session ends after 60 s of inactivity")</span>
    <span>
        <button type="button" id="textToggle">◐ Larger text</button>&nbsp;&nbsp;
        <button type="button" onclick="alert('Please ask a member of staff at the desk.')">? Ask staff for help</button>
    </span>
</footer>
<script src="~/js/kiosk.js" asp-append-version="true"></script>
<script>Kiosk.init({ idleSeconds: @idle, idleUrl: "@idleTo" });</script>
</body>
</html>
