@page
@model LibraHub.Pages.Staff.FinesModel
@{ ViewData["Title"] = "Fines"; ViewData["Nav"] = "fines"; }
<div class="card">
    <form method="get" class="row spread">
        <div class="row"><input name="Q" value="@Model.Q" placeholder="⌕ Search patron or item" />
            <select name="Status" data-autosubmit><option selected="@(Model.Status=="Outstanding")">Outstanding</option><option selected="@(Model.Status=="Collected")">Collected</option><option selected="@(Model.Status=="Waived")">Waived</option></select>
            <button class="btn" type="submit">Search</button></div>
        <div class="kpi" style="padding:.5rem 1rem"><div class="l">Outstanding total</div><div class="v" style="font-size:1.4rem">@Fmt.Money(Model.OutstandingTotal)</div></div>
    </form>
</div>
<partial name="_Flash" />
<div class="card">
    <div class="table-wrap"><table><thead><tr><th>Patron</th><th>Item</th><th>Days late</th><th>Amount</th><th>Status</th><th>Issued</th><th>Action</th></tr></thead><tbody>
    @foreach (var f in Model.Rows)
    {
        <tr><td>@f.Patron.FullName</td><td>@f.Loan.Item.Title</td><td>@f.DaysLate</td><td>@Fmt.Money(f.AmountCents)</td>
            <td><span class="badge @(f.Status==FineStatus.Outstanding?"b-amber":f.Status==FineStatus.Waived?"b-grey":"b-green")">@f.Status</span></td>
            <td>@Fmt.Day(f.IssuedAt)</td>
            <td>@if (f.Status == FineStatus.Outstanding)
            {
                <form method="post" asp-page-handler="Settle" style="display:inline"><input type="hidden" name="id" value="@f.Id" /><input type="hidden" name="to" value="collect" /><button class="btn btn-sm btn-primary" type="submit">Collect</button></form>
                <form method="post" asp-page-handler="Settle" style="display:inline"><input type="hidden" name="id" value="@f.Id" /><input type="hidden" name="to" value="waive" /><button class="btn btn-sm" type="submit">Waive</button></form>
            }</td></tr>
    }
    @if (Model.Rows.Count == 0) { <tr><td colspan="7" class="muted">No fines found.</td></tr> }
    </tbody></table></div>
</div>
