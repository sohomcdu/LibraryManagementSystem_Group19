@page
@model LibraHub.Pages.Staff.TransfersModel
@{ ViewData["Title"] = "Branch inventory & transfers"; ViewData["Nav"] = "transfers"; }
<div class="grid g3">
    @foreach (var (b, items, desks, pct) in Model.Stats)
    {
        <div class="kpi"><div class="l">@b.Name.ToUpper()</div><div class="v">@items.ToString("N0") items</div>
            <div class="s">@desks desk@(desks==1?"":"s") · @pct.ToString("0")% available</div></div>
    }
</div>
<partial name="_Flash" />
<div class="grid g2" style="margin-top:1rem">
    <div class="card">
        <h3>New transfer request</h3>
        <form method="post" asp-page-handler="Create">
            <label for="code">Item (scan code)</label><input id="code" name="Code" value="@Model.Code" placeholder="BK-100234 · Clean Code" required />
            <label for="from">From branch</label><input id="from" value="Detected from the item's current branch" disabled />
            <label for="to">To branch</label>
            <select id="to" name="ToBranchId">@foreach (var b in Model.Branches){<option value="@b.Value" selected="@(b.Value==Model.ToBranchId.ToString())">@b.Text</option>}</select>
            <label for="reason">Reason</label>
            <select id="reason" name="Reason"><option>Patron request</option><option>Rebalancing</option><option>Damaged / repair centre</option><option>Other</option></select>
            <button class="btn btn-primary" style="margin-top:1rem" type="submit">Create transfer</button>
        </form>
    </div>
    <div class="card">
        <h3>Transfers</h3>
        <div class="table-wrap"><table><thead><tr><th>#</th><th>Item</th><th>From → To</th><th>Requested</th><th>Status</th><th>Action</th></tr></thead><tbody>
        @foreach (var t in Model.Transfers)
        {
            <tr class="@(t==Model.Highlighted?"hl":"")">
                <td>@t.Number</td><td>@t.Item.Title</td>
                <td>@t.FromBranch.Name.Replace(" Library","").Replace(" Branch","") → @t.ToBranch.Name.Replace(" Library","").Replace(" Branch","")</td>
                <td>@Fmt.Day(t.RequestedAt)</td>
                <td><span class="badge @(t.Status switch{TransferStatus.Requested=>"b-grey",TransferStatus.Dispatched=>"b-purple",TransferStatus.Received=>"b-green",_=>"b-red"})">@t.Status</span></td>
                <td>
                    @if (t.Status == TransferStatus.Requested)
                    {
                        <form method="post" asp-page-handler="Dispatch" style="display:inline"><input type="hidden" name="id" value="@t.Id" /><button class="btn btn-sm" type="submit">Dispatch</button></form>
                        <form method="post" asp-page-handler="Cancel" style="display:inline"><input type="hidden" name="id" value="@t.Id" /><button class="btn btn-sm" type="submit">Cancel</button></form>
                    }
                    else if (t.Status == TransferStatus.Dispatched)
                    { <form method="post" asp-page-handler="Receive" style="display:inline"><input type="hidden" name="id" value="@t.Id" /><button class="btn btn-sm btn-primary" type="submit">Receive</button></form> }
                    else { <text>—</text> }
                </td>
            </tr>
        }
        </tbody></table></div>
    </div>
</div>
@if (Model.Highlighted != null)
{
    var t = Model.Highlighted;
    <div class="card">
        <h3>Transfer @t.Number progress</h3>
        <p class="muted">@t.Item.Title · @t.FromBranch.Name.Replace(" Library","").Replace(" Branch","") → @t.ToBranch.Name.Replace(" Library","").Replace(" Branch","")</p>
        <div class="stepper">
            <div class="step done"><b>1</b>Requested</div>
            <div class="step @(t.Status!=TransferStatus.Requested?"done":"")"><b>2</b>Dispatched</div>
            <div class="step @(t.Status==TransferStatus.Received?"done":"")"><b>3</b>Received</div>
        </div>
    </div>
}
