@page "{isbn?}"
@model LibraHub.Pages.Staff.HoldsModel
@{ ViewData["Title"] = "Holds & waitlist queue"; ViewData["Nav"] = "holds"; }
<partial name="_Flash" />
<div class="grid g2">
    <div>
        <div class="card">
            <h3>Items with waitlists</h3>
            <div class="table-wrap"><table><thead><tr><th>Item</th><th>Status</th><th>Queue</th></tr></thead><tbody>
            @foreach (var t in Model.Titles)
            {
                <tr class="@(t.Isbn==Model.SelectedIsbn?"hl":"")"><td><a href="/Staff/Holds/@t.Isbn"><strong>@t.Title</strong></a></td>
                    <td><partial name="_Badge" model="t.RepStatus" /></td><td>@t.Queue</td></tr>
            }
            @if (Model.Titles.Count == 0) { <tr><td colspan="3" class="muted">No active waitlists.</td></tr> }
            </tbody></table></div>
        </div>
        <div class="card">
            <h3>Ready for pickup (shelf)</h3>
            <div class="table-wrap"><table><thead><tr><th>Item</th><th>Patron</th><th>Expires</th><th>Action</th></tr></thead><tbody>
            @foreach (var r in Model.Ready)
            {
                <tr>
                    <td>@r.TitleText</td>
                    <td>@(r.Patron?.FullName ?? "Unknown")</td>
                    <td>@(r.ExpiresAt.HasValue ? Fmt.Day(r.ExpiresAt.Value) : "-")</td>
                    <td>
                        <form method="post" asp-page-handler="PickedUp">
                            <input type="hidden" name="id" value="@r.Id" />
                            <button class="btn btn-sm btn-primary" type="submit">Picked up</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Ready.Count == 0) { <tr><td colspan="4" class="muted">None</td></tr> }
            </tbody></table></div>
        </div>
    </div>
    <div>
        @if (Model.SelectedIsbn != null)
        {
            <div class="card">
                <h3>Queue · @(Model.Titles.FirstOrDefault(t => t.Isbn == Model.SelectedIsbn)?.Title)</h3>
                <div class="table-wrap"><table><thead><tr><th>Pos</th><th>Patron</th><th>Placed</th><th>Notification</th></tr></thead><tbody>
                @foreach (var (pos, r) in Model.Queue)
                { <tr><td>@pos</td><td>@r.Patron.FullName</td><td>@Fmt.Day(r.PlacedAt)</td><td><span class="badge b-grey">Not yet</span></td></tr> }
                </tbody></table></div>
                <p class="small muted">When the item becomes Available, position 1 is notified automatically and the item is set to Reserved.</p>
                @if (Model.Queue.Count > 0)
                {
                    <form method="post" asp-page-handler="Cancel" style="display:inline"><input type="hidden" name="id" value="@Model.Queue[0].R.Id" /><input type="hidden" name="isbn" value="@Model.SelectedIsbn" /><button class="btn btn-sm btn-danger" type="submit">Cancel hold</button></form>
                    <form method="post" asp-page-handler="Front" style="display:inline"><input type="hidden" name="id" value="@Model.Queue[0].R.Id" /><input type="hidden" name="isbn" value="@Model.SelectedIsbn" /><button class="btn btn-sm" type="submit">Move to front</button></form>
                }
            </div>
        }
        @if (Model.IsManagerUp)
        {
            <div class="card">
                <h3>Waitlist settings (manager)</h3>
                <form method="post" asp-page-handler="Settings" class="grid g2">
                    <div><label for="ph">Pickup window (days)</label><input id="ph" name="PickupDays" type="number" value="@Model.PickupDays" /></div>
                    <div><label for="mh">Max holds per patron</label><input id="mh" name="MaxHolds" type="number" value="@Model.MaxHolds" /></div>
                    <div style="grid-column:1/-1"><button class="btn btn-primary" type="submit">Save settings</button></div>
                </form>
            </div>
        }
    </div>
</div>
