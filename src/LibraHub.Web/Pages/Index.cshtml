@page
@model LibraHub.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
    ViewData["Nav"] = "home";
}

<section class="hero home-hero hero-anim">
    <div class="inner">
        @if (Model.SignedIn)
        {
            <h1 class="hero-title">Welcome back, @Model.FirstName!</h1>
        }
        else
        {
            <h1 class="hero-title">Welcome to LibraHub</h1>
        }
        <p class="hero-sub">Books, music, toys and more — Can borrow across three branches. No account needed to look, just to borrow.</p>

        <form method="get" action="/Catalogue" class="home-search hero-search" role="search">
            <label class="sr-only" for="home-q">Search the catalogue</label>
            <input id="home-q" type="search" name="q" placeholder="⌕ Search title, author, ISBN or keyword…" />
            <button class="btn btn-accent btn-lg pulse-hint" type="submit">Search the catalogue</button>
        </form>


    </div>
</section>

<div class="container">

    <section aria-labelledby="locations-h" class="reveal-section">
        <div class="row spread" style="align-items:baseline">
            <h2 id="locations-h">Where we're located</h2>
        </div>
        <div class="grid g3 stagger">
            @foreach (var b in Model.Branches)
            {
                var h = BranchHours.For(b, Clock.Now);
                <div class="card branch-card lift">
                    <div class="row spread">
                        <h3 style="margin:0">@b.Name</h3>
                        <span class="status-badge @(h.Open ? "is-open" : "is-closed")">
                            <span class="status-dot" aria-hidden="true"></span>
                            @(h.Open ? "Open" : "Closed")
                        </span>
                    </div>
                    <p class="muted small" style="margin:.4rem 0 1rem">
                        @(h.Open ? $"Closes {b.ClosesAt:h:mm tt}" : $"Opens {b.OpensAt:h:mm tt}") ·
                        @b.OpensAt.ToString("h:mm tt") – @b.ClosesAt.ToString("h:mm tt") daily
                    </p>
                    <a class="btn btn-sm btn-block" href="/Catalogue?branch=@b.Id">Browse this branch's catalogue</a>
                </div>
            }
        </div>
    </section>

    <section aria-labelledby="offer-h" style="margin-top:2.5rem" class="reveal-section">
        <h2 id="offer-h">What you'll find at LibraHub</h2>
        <p class="muted">A library card gets you a lot more than books.</p>
        <div class="grid g4 stagger">
            <a class="card offer-tile lift" href="/Catalogue">
                <span class="offer-icon bob">📚</span>
                <h3>Books &amp; eBooks</h3>
                <p class="small muted">Fiction, technology, science, history and more — searchable across every branch.</p>
            </a>
            <a class="card offer-tile lift" href="/Catalogue">
                <span class="offer-icon bob">🎵</span>
                <h3>Music &amp; audio</h3>
                <p class="small muted">CDs, audiobooks and streaming guides, in branch and online.</p>
            </a>
            <a class="card offer-tile lift" href="/Catalogue">
                <span class="offer-icon bob">🧸</span>
                <h3>Toys &amp; games</h3>
                <p class="small muted">Board games and early-learning toys for the kids' corner at every branch.</p>
            </a>
            <a class="card offer-tile lift" href="/Branches">
                <span class="offer-icon bob">🏛️</span>
                <h3>Study spaces &amp; events</h3>
                <p class="small muted">Quiet desks, meeting rooms and regular community events.</p>
            </a>
        </div>
    </section>

</div>

