@page
@model LibraHub.Pages.Catalogue.IndexModel
@{
    ViewData["Title"] = "Catalogue";
    ViewData["Nav"] = "catalogue";
    var r = Model.Result;
}

<form method="get" action="/Catalogue" id="searchForm">
    <section class="hero">
        <div class="inner">
            <h1>Find your next read</h1>
            <p>Search the catalogue across all three branches — no account needed.</p>
            <div class="searchbar" role="search">
                <div>
                    <label class="sr-only" for="q">Keyword</label>
                    <input id="q" type="search" name="q" value="@Model.Q" placeholder="Search title, author, ISBN or keyword..." />
                </div>
                <div>
                    <label class="sr-only" for="category">Category</label>
                    <select id="category" name="category">
                        <option value="">Category: All</option>
                        @foreach (var o in Model.CategoryOptions)
                        {
                            <option value="@o.Value" selected="@o.Selected">@o.Text</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="sr-only" for="branch">Branch</label>
                    <select id="branch" name="branch">
                        <option value="">Branch: All</option>
                        @foreach (var o in Model.BranchOptions)
                        {
                            <option value="@o.Value" selected="@o.Selected">@o.Text</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="sr-only" for="avail">Availability</label>
                    <select id="avail" name="availability">
                        <option value="any" selected="@(Model.Availability is null or "any")">Availability: Any</option>
                        <option value="available" selected="@(Model.Availability == "available")">Available now</option>
                        <option value="borrowed" selected="@(Model.Availability == "borrowed")">Borrowed (can reserve)</option>
                        <option value="damaged" selected="@(Model.Availability == "damaged")">Damaged</option>
                    </select>
                </div>
                <button class="btn btn-accent" type="submit">Search</button>
            </div>
        </div>
    </section>

    <div class="catalogue">
        <aside class="card refine" id="refine" aria-label="Refine results">
            <h3>Refine results</h3>
            <h4>Category</h4>
            @foreach (var f in r.CategoryFacets)
            {
                <label><input type="checkbox" name="cats" value="@f.Id" checked="@Model.Cats.Contains(f.Id)" data-autosubmit /> @f.Name (@f.Count)</label>
            }
            <h4>Branch</h4>
            @foreach (var f in r.BranchFacets)
            {
                <label><input type="checkbox" name="brs" value="@f.Id" checked="@Model.Brs.Contains(f.Id)" data-autosubmit /> @f.Name (@f.Count)</label>
            }
            <h4>Availability</h4>
            <label><input type="checkbox" name="avs" value="available" checked="@Model.Avs.Contains("available")" data-autosubmit /> Available now (@r.AvailFacets.GetValueOrDefault("available"))</label>
            <label><input type="checkbox" name="avs" value="borrowed" checked="@Model.Avs.Contains("borrowed")" data-autosubmit /> Borrowed (can reserve) (@r.AvailFacets.GetValueOrDefault("borrowed"))</label>
            <label><input type="checkbox" name="avs" value="damaged" checked="@Model.Avs.Contains("damaged")" data-autosubmit /> Damaged / in repair (@r.AvailFacets.GetValueOrDefault("damaged"))</label>
            @if (Model.HasFilters)
            {
                <p><a href="/Catalogue?q=@Uri.EscapeDataString(Model.Q ?? "")">Clear filters</a></p>
            }
        </aside>

        <section aria-live="polite">
            <div class="sortbar">
                <div>
                    <strong>@r.Total result@(r.Total == 1 ? "" : "s")</strong>
                    @if (!string.IsNullOrWhiteSpace(Model.Q))
                    {
                        <span class="muted"> for "@Model.Q"</span>
                    }
                    <button type="button" class="btn btn-sm" style="display:none" id="refineBtn"
                            onclick="document.getElementById('refine').classList.toggle('open')">Filters</button>
                </div>
                <div class="row">
                    <label for="sort" style="margin:0" class="muted">Sort by</label>
                    <select id="sort" name="sort" data-autosubmit>
                        <option value="relevance" selected="@(Model.Sort == "relevance")">Relevance</option>
                        <option value="title" selected="@(Model.Sort == "title")">Title A-Z</option>
                        <option value="newest" selected="@(Model.Sort == "newest")">Newest</option>
                        <option value="availability" selected="@(Model.Sort == "availability")">Availability</option>
                    </select>
                </div>
            </div>

            @if (r.Total == 0)
            {
                <div class="card">
                    <h3>No results found</h3>
                    <p>Try fewer words, check the spelling, or search by ISBN.</p>
                    <p class="muted">Suggestions: "design", "clean code", "Dune", "Harari".</p>
                    <a class="btn btn-primary" href="/Catalogue">Clear filters</a>
                </div>
            }

            @foreach (var t in r.Rows)
            {
                var anyAvail = t.Copies.Any(c => c.Status == ItemStatus.Available);
                var byBranch = t.Copies.GroupBy(c => c.CurrentBranch).OrderBy(g => g.Key.Id).ToList();
                // Ensure callers use the named CoverViewModel for clarity and correct icon mapping
                string? __catName = null;
                if (t.Category != null) {
                    var cp = t.Category.GetType().GetProperty("Name");
                    if (cp != null) __catName = cp.GetValue(t.Category) as string;
                    else __catName = t.Category.ToString();
                }
                var __coverVm = new LibraHub.Pages.Shared.ViewModels.CoverViewModel(t.CoverColors, "mid", __catName);
                <article class="result">
                    <partial name="_Cover" model="@(__coverVm)" />
                    <div class="meta">
                        <h3><a href="/Catalogue/Details/@t.FirstItemId">@t.Title</a></h3>
                        <div class="muted small">@t.Author · @t.Category</div>
                        <div class="badges">
                            @foreach (var g in byBranch)
                            {
                                var rep = g.Any(c => c.Status == ItemStatus.Available)
                                    ? ItemStatus.Available
                                    : g.OrderBy(c => c.Status).First().Status;
                                <span>@g.Key.Name.Replace(" Library", "").Replace(" Branch", "")</span>
                                <partial name="_Badge" model="rep" />
                            }
                        </div>
                    </div>
                    <div class="actions">
                        <a class="btn btn-sm" href="/Catalogue/Details/@t.FirstItemId">View details</a>
                        @if (anyAvail)
                        {
                            <a class="btn btn-sm btn-primary" href="/Catalogue/Details/@t.FirstItemId">Reserve</a>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-accent" href="/Catalogue/Details/@t.FirstItemId">Join waitlist (@t.Queue)</a>
                        }
                    </div>
                </article>
            }

            @if (r.Pages > 1)
            {
                <nav class="pager" aria-label="Pagination">
                    @if (r.PageNo > 1)
                    {
                        <a href="@Model.PageUrl(r.PageNo - 1)">&lsaquo; Prev</a>
                    }
                    @for (var p = 1; p <= r.Pages; p++)
                    {
                        if (p == r.PageNo)
                        {
                            <span class="cur" aria-current="page">@p</span>
                        }
                        else if (p <= 3 || p == r.Pages || Math.Abs(p - r.PageNo) <= 1)
                        {
                            <a href="@Model.PageUrl(p)">@p</a>
                        }
                        else if (p == 4)
                        {
                            <span>...</span>
                        }
                    }
                    @if (r.PageNo < r.Pages)
                    {
                        <a href="@Model.PageUrl(r.PageNo + 1)">Next &rsaquo;</a>
                    }
                </nav>
            }
        </section>
    </div>
</form>

<script>
    if (matchMedia('(max-width:768px)').matches) {
        document.getElementById('refineBtn').style.display = 'inline-flex';
    }
</script>
<script src="~/js/site.js"></script>