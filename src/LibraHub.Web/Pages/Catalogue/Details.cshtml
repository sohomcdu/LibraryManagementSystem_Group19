@page "{id:int}"
@model LibraHub.Pages.Catalogue.DetailsModel
@{
    var v = Model.View;
}

@if (v == null)
{
    <div class="container"><div class="card"><h3>Item not found</h3><p class="muted">This item could not be loaded.</p></div></div>
}
else
{
    var it = v!.Item;
    // Safely extract category name (Category may be a domain object)
    string? catName = null;
    if (it.Category != null)
    {
        var catObj = it.Category;
        var nameProp = catObj.GetType().GetProperty("Name");
        if (nameProp != null)
            catName = nameProp.GetValue(catObj) as string;
        else
            catName = catObj.ToString();
    }

    ViewData["Title"] = it.Title; ViewData["Nav"] = "catalogue";
    var full = (Model.MyHold == null) && ((v?.AvailableCopies ?? 0) == 0);
    <div class="container" style="max-width:1120px">
    <div class="breadcrumb"><a href="/Catalogue">Catalogue</a> › <a href="/Catalogue?category=@it.CategoryId">@catName</a> › <strong>@it.Title</strong></div>
    <partial name="_Flash" />
    <div class="details">
            <div class="card cover-card">
    <partial name="_Cover" model="@(new LibraHub.Pages.Shared.ViewModels.CoverViewModel(it.CoverColors, "big", catName))" />
        </div>
        <div class="card">
            <h1 style="font-size:1.7rem">@it.Title</h1>
            @if (!string.IsNullOrEmpty(it.Subtitle)) { <div class="muted">@it.Subtitle</div> }
            <p><strong>@it.Author</strong></p>
            <dl>
                <div><dt>ISBN</dt><dd>@Isbn.Display(it.Isbn)</dd></div>
                <div><dt>Category</dt><dd>@catName</dd></div>
                <div><dt>Publisher</dt><dd>@it.Publisher</dd></div>
                <div><dt>Year</dt><dd>@it.Year</dd></div>
                <div><dt>Language</dt><dd>@it.Language</dd></div>
                <div><dt>Pages</dt><dd>@it.Pages</dd></div>
            </dl>
            <p class="muted">@it.Description</p>
        </div>
        <div class="card">
            <h3>Availability by branch</h3>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Branch</th><th>Copies</th><th>Status</th><th>Note</th></tr></thead>
                    <tbody>
                    @foreach (var b in v!.Branches)
                    {
                        <tr>
                            <td>@b.Branch.Name</td>
                            <td>@b.Available of @b.Copies<br /><span class="small muted">available</span></td>
                            <td><partial name="_Badge" model="b.Status" /></td>
                            <td class="small">@b.Note</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            @if (Model.MyHold != null)
            {
                <div class="queue-banner">
                        @if (Model.MyHold.Status == HoldStatus.Ready)
                        {
                            <text>
                                Your hold is <strong>ready</strong> at @Model.MyHold.PickupBranch.Name
                                @if (Model.MyHold.ExpiresAt.HasValue)
                                {
                                    <text>— collect by @Fmt.Day(Model.MyHold.ExpiresAt.Value).</text>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.MyHold.PickupCode))
                                {
                                    <text> Pickup code <strong>@Model.MyHold.PickupCode</strong>.</text>
                                }
                            </text>
                        }
                    else
                    {
                        <text>You are <strong>#@Model.MyPosition</strong> in the queue for this title.</text>
                    }
                </div>
                <form method="post" asp-page-handler="Cancel" asp-route-id="@it.Id" onsubmit="return confirm('Cancel this hold?')">
                    <input type="hidden" name="holdId" value="@Model.MyHold.Id" />
                    <button class="btn btn-block btn-danger" type="submit">Cancel my hold</button>
                </form>
            }
            else if (full)
            {
                <div class="queue-banner">All copies are out or unavailable. You would be <strong>#@(v.Queue + 1)</strong> in the queue · estimated wait @v.EstimatedWait</div>
                <form method="post" asp-page-handler="Join" asp-route-id="@it.Id">
                    @if (Model.IsPatron)
                    {
                        <label for="pickup">Pickup branch</label>
                        <select id="pickup" name="PickupBranchId">
                            @foreach (var b in Model.Branches) { <option value="@b.Id" selected="@(b.Id == Model.PickupBranchId)">@b.Name</option> }
                        </select><br /><br />

                    }
                    <button class="btn btn-primary btn-block btn-lg" type="submit">Join the waitlist</button>
                </form>
                <p class="small muted">@(User.Identity?.IsAuthenticated == true ? "" : "Sign in to join. ")You'll get an email/SMS when it's ready to collect.</p>
            }
            else
            {
                <div class="alert alert-ok" style="margin-top:1rem">Available now — borrow at the desk or kiosk.</div>
                @if (User.IsInRole(nameof(Role.Patron)))
                {
                    <form method="post" asp-page-handler="Reserve" asp-route-id="@it.Id">
                        <input type="hidden" name="PickupBranchId" value="@Model.PickupBranchId" />
                        <button class="btn btn-primary" type="submit">Reserve</button>
                    </form>
                }
            }
        </div>
    </div>

    @if (v!.Similar.Count > 0)
    {
        <h3 style="margin-top:1.5rem">Similar items</h3>
        <div class="similar">
            @foreach (var s in v.Similar)
            {
                string? sCat = null;
                if (s.Category != null)
                {
                    var cp = s.Category.GetType().GetProperty("Name");
                    if (cp != null) sCat = cp.GetValue(s.Category) as string;
                    else sCat = s.Category.ToString();
                }
                <a href="/Catalogue/Details/@s.Id">
                    <partial name="_Cover" model="@(new LibraHub.Pages.Shared.ViewModels.CoverViewModel(s.CoverColors, "mid", sCat))" />
                    @s.Title
                </a>
            }
        </div>
    }
    </div>
}
